{
  "name": "manifold",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/canvas",
    "apps/assistant",
    "packages/foundation",
    "packages/cli"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "doctor": "node scripts/doctor.mjs",
    "setup:browser": "playwright install chromium",
    "build": "npm --workspace manifold-canvas run build",
    "typecheck": "npm --workspace manifold-canvas run check && npm --workspace @manifold/foundation run check",
    "test": "npm --workspace manifold-canvas test --",
    "test:browser": "npm --workspace manifold-canvas run test:all-browser --",
    "test:dev": "node --test scripts/dev.test.mjs",
    "test:dev:browser": "node scripts/dev-browser.mjs",
    "assistant": "node apps/assistant/src/main.mjs",
    "mcp": "node apps/assistant/src/mcp-main.mjs",
    "build:tools": "node packages/cli/build.mjs",
    "test:tools": "node --test packages/cli/test/*.test.mjs",
    "check": "make check",
    "verify": "make verify-application-foundation"
  },
  "overrides": {
    "katex": "0.19.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
